# Copia este archivo como .env y rellena los valores. El .env NUNCA se sube a GitHub.
# En Render no se usa este archivo: pon las mismas variables en Environment.

# --- Web / sesión ---
PUBLIC_URL=http://localhost:5173
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# --- Steam (opcional: nombre y avatar) https://steamcommunity.com/dev/apikey ---
STEAM_API_KEY=

# --- Stripe https://dashboard.stripe.com/test/apikeys ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Servidor ARK (RCON + ArkShop) ---
RCON_HOST=
RCON_PORT=27020
RCON_PASSWORD=
# RCON_POINTS_CMD=AddPoints {steamid} {points}
